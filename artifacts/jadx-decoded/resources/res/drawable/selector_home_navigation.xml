<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#05ffc107"
                android:endColor="#05ffc107"
                android:angle="0"/>
            <corners android:radius="@dimen/_8sdp"/>
            <stroke
                android:width="1dp"
                android:color="#ff430181"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#01ffffff"
                android:endColor="#01ffffff"
                android:angle="0"/>
            <corners android:radius="@dimen/_8sdp"/>
            <stroke
                android:width="1dp"
                android:color="#00ffffff"/>
        </shape>
    </item>
</selector>
